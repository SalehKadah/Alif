# دالّةُ بناءٍ لا شجرةٌ جاهزة — المسارُ الذي تسلكه الواجهاتُ التفاعليّة.
من رسومات استورد نص_عنصر, عمود, رسم_ولقطة

صنف حالة:
	دالة __تهيئة__(نفس):
		نفس.عدد = 7

ح = حالة()

دالة الواجهة():
	ارجع عمود(
		نص_عنصر(ح.عدد).حجم_خط(80).لون("#22cc22")
	).لون_خلفية("#101820").حشوة(30)

اطبع("لقطة:", رسم_ولقطة(الواجهة, "مشهد_دالة_بناء.bmp", 400, 240))
