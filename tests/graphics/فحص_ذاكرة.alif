# هل تُخلّف وحدةُ الرسومات شيئاً بعد آلافِ الأشجار؟
#
# البناءُ وحدَه، بلا نافذةٍ ولا تصيير: عشرةُ آلافِ شجرةٍ من ثلاثٍ وستّين
# عقدةً — حاوياتٌ وأوراقٌ وقوائمُ تُفكَّك — ثمّ يُقاس الفرق.
#
# **كلُّ النصوصِ ثابتةٌ عمداً.** ألفُ تُسرّب النصَّ الناتجَ عن تحويلِ حقلٍ
# غيرِ نصّيٍّ في `م"…"` (‏نحوُ ٨٢ بايتاً لكلّ تحويل، مقيسٌ بلا رسومات
# أصلاً)، فلو استعملنا `م"بطاقة {ر}"` هنا لقاسَ هذا الفحصُ تسريبَ ألفَ
# ونسبَه إلى الرسومات. الثوابتُ تعزل ما نملك إصلاحَه.

من رسومات استورد نص_عنصر, زر, عمود, صف, بطاقة, ذاكرة

الأسماء = ["الأوّل", "الثاني", "الثالث", "الرابع", "الخامس",
           "السادس", "السابع", "الثامن", "التاسع", "العاشر"]

دالة الواجهة():
	الصفوف = []
	لكل ر في مدى(10):
		الصفوف.اضف(
			صف(
				بطاقة(نص_عنصر(الأسماء[ر])).لون_خلفية("#1b2437"),
				بطاقة(نص_عنصر("قيمة")).لون_خلفية("#141c2c"),
				بطاقة(نص_عنصر("ثابت")).لون_خلفية("#2b3346")
			).تباعد(6)
		)
	ارجع عمود(
		نص_عنصر("عنوان").حجم_خط(22).لون("#ffd479"),
		زر("زد").لون_خلفية("#3a4256"),
		عمود(*الصفوف).تباعد(4)
	).لون_خلفية("#0b1a2e").حشوة(12).تباعد(8)


# إحماءٌ يُثبّت تخصيصاتِ المفسّرِ الأولى قبل القياس
لكل ر في مدى(500):
	ع = الواجهة()

أ = ذاكرة()
لكل ر في مدى(10000):
	ع = الواجهة()
ب = ذاكرة()

اطبع(م"أشجار=10000")
اطبع(م"فرق_ك.ب={ب-أ:.0ف}")
