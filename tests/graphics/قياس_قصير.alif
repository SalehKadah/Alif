# فحصُ المسار التفاعليّ — القصيرُ الذي يصلح بوّابةً في CI
#
# المشاهدُ الأربعةُ الأخرى تُسجّل المعالِجاتِ ولا تُطلقها، فالمسارُ الذي
# ينهار فيه الاستعمالُ بعد التحرير ويتسرّب فيه السجلُّ لم يكن مفحوصاً
# أصلاً. هذا يُطلق ثلاثَ مئةِ نقرةٍ حقيقيّة ويطبع ما يُتحقَّق منه.

من رسومات استورد نص_عنصر, زر, عمود, صف, بطاقة, قياس_تفاعل

صنف حالة:
	دالة __تهيئة__(نفس):
		نفس.عدد = 0

ح = حالة()

دالة زد():
	ح.عدد += 1

دالة الواجهة():
	الصفوف = []
	لكل ر في مدى(8):
		الصفوف.اضف(
			صف(
				بطاقة(نص_عنصر(م"بطاقة {ر}")).لون_خلفية("#1b2437"),
				بطاقة(نص_عنصر(م"قيمة {ح.عدد}")).لون_خلفية("#141c2c")
			).تباعد(6)
		)
	ارجع عمود(
		نص_عنصر(م"العدّاد: {ح.عدد}").حجم_خط(20).لون("#ffd479"),
		زر("زد").لون_خلفية("#3a4256").عند_النقر(زد),
		عمود(*الصفوف).تباعد(4)
	).لون_خلفية("#0b1a2e").حشوة(10).تباعد(6)


ن = قياس_تفاعل(الواجهة, عدد=300, عرض=420, ارتفاع=340)

اطبع(م"عيّنات={ن[0]}")
اطبع(م"نقرات={ح.عدد}")
اطبع(م"وسيط_العمل={ن[6]:.4ف}")
اطبع(م"أقصى_العمل={ن[8]:.4ف}")
اطبع(م"معالجات={ن[12]}")
