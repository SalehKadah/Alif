من رسومات استورد نص_عنصر, عمود, صف, وسط, حاوية, شبكة, شريط_تطبيق, شريط_حالة
من رسومات استورد أيقونة, شارة, رقاقة, صورة_رمزية, منطقة_نص, شريط_بحث, زر_عائم
من رسومات استورد زر_راديو, كتلة_كود, مؤشر_انشغال, شريط_تقدم, منزلق, صندوق_تجميع, رسم_ولقطة

المشهد = عمود(
	شريط_تطبيق(نص_عنصر("تطبيقُ ألف").حجم_خط(24).لون("#ffffff")),
	صف(
		أيقونة("★").حجم_خط(26).لون("#ffd479"),
		شارة("٣").حجم_خط(16),
		رقاقة("وسم").حجم_خط(16),
		صورة_رمزية("ص").حجم_خط(20)
	).تباعد(12),
	شريط_بحث("ابحث…").حجم_خط(18),
	منطقة_نص("اكتب فقرة…").حجم_خط(16),
	شريط_تقدم(65).عرض(300).ارتفاع(14),
	منزلق(40).عرض(300),
	صف(
		زر_راديو("خيار أ").حجم_خط(16),
		زر_راديو("خيار ب").حجم_خط(16)
	).تباعد(16),
	صندوق_تجميع(نص_عنصر("داخلَ صندوق").حجم_خط(16).لون("#e6e6e6")),
	كتلة_كود("س = ١ + ٢").حجم_خط(15),
	صف(مؤشر_انشغال(), زر_عائم("+").حجم_خط(22)).تباعد(20),
	وسط(نص_عنصر("موسَّطٌ").حجم_خط(18).لون("#8fa3bf")),
	شريط_حالة(نص_عنصر("جاهز").حجم_خط(14).لون("#8fa3bf"))
).لون_خلفية("#0b1a2e").حشوة(20).تباعد(12)

اطبع("لقطة:", رسم_ولقطة(المشهد, "مشهد_سطح.bmp", 700, 760))
