# ══════════════════════════════════════════════════════════════════════
# زمنُ النقرةِ إلى الصورة، وما تُخلّفه عشرةُ آلافِ نقرة
#
# ما كان مقيساً حتّى الآن أطوارٌ منفردة: بناءٌ، مطابقةٌ، تخطيطٌ، تصيير.
# وهي لا تُجيب عن سؤال المستعمِل: كم يمضي بين نقرةٍ وصورة؟ ولا عن سؤال
# التسريب: ماذا يبقى بعد عشرةِ آلاف؟
#
# `قياس_تفاعل` يُنادي معالِجَ أوّلِ زرٍّ كما يُناديه حدثُ SDL، ثمّ يُعيد
# البناءَ ويُطابق ويُرقّع ويُصيّر، ويقيس الدورةَ كاملة. النسبُ المئويّةُ
# لا المتوسّط: المتوسّطُ يُخفي التلعثمَ الذي يراه المستعمِل، و٩٥ هي التي
# يُشتكى منها.
#
# ساعتان: الكاملةُ تنتهي عند نبضةِ الشاشة (المُصيِّرُ مزامَنٌ عموديّاً)،
# وساعةُ العمل تنتهي عند فراغِ الترقيع. الأولى ما يشعر به المستعمِل،
# والثانيةُ ما ينمو مع حجمِ الشجرة.
# ══════════════════════════════════════════════════════════════════════

من رسومات استورد نص_عنصر, زر, عمود, صف, بطاقة, قياس_تفاعل

صنف حالة:
	دالة __تهيئة__(نفس):
		نفس.عدد = 0

ح = حالة()

دالة زد():
	ح.عدد += 1

# شجرةٌ بحجمِ واجهةٍ حقيقيّة: عشرون صفّاً في كلٍّ ثلاثُ بطاقات
دالة الواجهة():
	الصفوف = []
	لكل ر في مدى(20):
		الصفوف.اضف(
			صف(
				بطاقة(نص_عنصر(م"بطاقة {ر}")).لون_خلفية("#1b2437"),
				بطاقة(نص_عنصر(م"قيمة {ح.عدد}")).لون_خلفية("#141c2c"),
				بطاقة(نص_عنصر("ثابت")).لون_خلفية("#2b3346")
			).تباعد(6)
		)
	ارجع عمود(
		نص_عنصر(م"العدّاد: {ح.عدد}").حجم_خط(22).لون("#ffd479"),
		زر("زد").لون_خلفية("#3a4256").عند_النقر(زد),
		عمود(*الصفوف).تباعد(4)
	).لون_خلفية("#0b1a2e").حشوة(12).تباعد(8)


ن = قياس_تفاعل(الواجهة, عدد=10000, عرض=640, ارتفاع=480)

اطبع(م"عيّنات ................. {ن[0]}")
اطبع("── الدورةُ كاملةً (بانتظارِ المزامنة) ──")
اطبع(م"الوسيط ............. م.ث {ن[1]:.3ف}")
اطبع(م"٩٥٪ ................. م.ث {ن[2]:.3ف}")
اطبع(م"٩٩٪ ................. م.ث {ن[3]:.3ف}")
اطبع(م"الأقصى ............. م.ث {ن[4]:.3ف}")
اطبع(م"المتوسّط ........... م.ث {ن[5]:.3ف}")
اطبع("── العملُ وحدَه (نداءٌ + بناءٌ + مطابقةٌ + ترقيع) ──")
اطبع(م"الوسيط ............. م.ث {ن[6]:.3ف}")
اطبع(م"٩٥٪ ................. م.ث {ن[7]:.3ف}")
اطبع(م"الأقصى ............. م.ث {ن[8]:.3ف}")
اطبع("── الذاكرةُ الخاصّةُ الملتزَمة ──")
اطبع(م"بعد الإحماء ........ ك.ب {ن[9]:.0ف}")
اطبع(م"عند المنتصف ........ ك.ب {ن[10]:.0ف}")
اطبع(م"في النهاية ......... ك.ب {ن[11]:.0ف}")
اطبع(م"معالِجات باقية ......... {ن[12]}")
