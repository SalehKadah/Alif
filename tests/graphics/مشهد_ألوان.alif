# مشهدٌ مرجعيّ: ثلاثةُ ألوانٍ معلومةٌ في ثلاثةِ مواضع.
# الفحصُ لا يقارن صورةً بصورة (فالخطوطُ تختلف بين المنصّات)، بل يتحقّق
# من أنّ الألوانَ المطلوبةَ بلغت البكسل — وهذا يُثبت أنّ السلسلةَ كلَّها
# عملت: بناءٌ ⇒ تخطيطٌ ⇒ تصييرٌ ⇒ نافذة.
من رسومات استورد نص_عنصر, زر, عمود, صف, رسم_ولقطة

المشهد = عمود(
	نص_عنصر("عنوان").حجم_خط(40).لون("#ffd479"),
	نص_عنصر("متن").حجم_خط(24).لون("#e6e6e6"),
	صف(
		زر("أ").حجم_خط(20).لون_خلفية("#3a4256"),
		زر("ب").حجم_خط(20).لون_خلفية("#3a4256")
	).تباعد(12)
).لون_خلفية("#0b1a2e").حشوة(30).تباعد(18)

اطبع("لقطة:", رسم_ولقطة(المشهد, "مشهد_ألوان.bmp", 600, 400))
