من رسومات استورد نص_عنصر, زر, عمود, صف, بطاقة, لفافة, صورة, حقل_نص, مفتاح, خانة_اختيار, فاصل, فاصل_خط, رسم_ولقطة

دالة لاشيء():
	ارجع 0

المشهد = عمود(
	نص_عنصر("سطحُ الواجهة").حجم_خط(30).لون("#ffd479"),
	فاصل_خط(),
	بطاقة(
		صف(
			مفتاح("مفتاح").عند_تغير(لاشيء),
			خانة_اختيار("خانة").عند_تغير(لاشيء)
		).تباعد(14)
	).لون_خلفية("#16233a").حشوة(14),
	حقل_نص("اكتب هنا").حجم_خط(20).لون("#e6e6e6"),
	فاصل(16),
	لفافة(
		نص_عنصر("محتوًى داخلَ لفافة").حجم_خط(18).لون("#8fa3bf")
	),
	زر("موافق").حجم_خط(22).لون_خلفية("#3a4256").عند_النقر(لاشيء)
).لون_خلفية("#0b1a2e").حشوة(24).تباعد(14)

اطبع("لقطة:", رسم_ولقطة(المشهد, "مشهد_عناصر.bmp", 640, 520))
