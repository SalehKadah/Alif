# ══════════════════════════════════════════════════════════════════════
# المشهدُ المركَّب — جدولٌ وتقويمٌ وألسنة
#
# ثلاثتُها كانت مستبعَدةً: المُصيِّرُ يرسم لها شكلاً بلا بيانات. صارت
# تُبنى تركيباً من عُقَدٍ تعمل، فهذا المشهدُ يُثبت أنّ البياناتِ تبلغ
# البكسل: لونُ رأسِ الجدول، ولونُ الصفوفِ المتناوبة، ولونُ اليوم
# المحدَّد، ولونُ اللسانِ المختار.
# ══════════════════════════════════════════════════════════════════════

من رسومات استورد عمود, صف, نص_عنصر, جدول_بيانات, تقويم, ألسنة, رسم_ولقطة

الجدول = جدول_بيانات(
	["اللغة", "السنة"],
	[
		["ص", 2024],
		["ألف", 2022],
		["سي", 1972]
	],
	عرض_عمود=130
)

التقويم = تقويم(2026, 9, يوم=6, عرض_خلية=38)

الشريط = ألسنة(["الملف", "تحرير", "عرض"], 1, عرض_لسان=110)

السطح = عمود(
	نص_عنصر("عناصرُ مركَّبة").حجم_خط(28).لون("#ffd479"),
	الشريط,
	صف(الجدول, التقويم).تباعد(24)
).لون_خلفية("#0b1a2e").حشوة(24).تباعد(18)

اطبع("لقطة:", رسم_ولقطة(السطح, "مشهد_مركب.bmp", 820, 560))
