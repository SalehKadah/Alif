# ══════════════════════════════════════════════════════════════════════
# عدّادٌ تفاعليّ — تصريحيٌّ بالكامل، بلا حلقةٍ ولا إطارٍ ولا وقتٍ ظاهر
#
# النمطُ: حالةٌ، ومعالِجٌ يُعدّلها، ودالّةُ بناءٍ تصف الشكلَ من الحالة.
# بعد كلّ معالِجٍ يُعاد بناءُ الوصف، ويُقارَن بالسابق، ويُرقَّع الفرقُ وحدَه
# (‏diff/patch)، فلا تُعاد بناءُ النافذةِ ولا تُصفَّر التحريكات.
# ══════════════════════════════════════════════════════════════════════

من رسومات استورد نص_عنصر, زر, عمود, صف, تشغيل_تطبيق

# ─── الحالة: كائنُ ألفٍ عاديّ، لا نموذجَ حالةٍ خاصّ ───
صنف حالة:
	دالة __تهيئة__(نفس):
		نفس.عدد = 0

ح = حالة()

# ─── المعالِجات ───
دالة زد():
	ح.عدد += 1

دالة انقص():
	ح.عدد -= 1

دالة صفر():
	ح.عدد = 0

# ─── الوصف: دالّةٌ من الحالة إلى الشكل ───
دالة الواجهة():
	ارجع عمود(
		نص_عنصر("عدّادُ ألف")
			.حجم_خط(30)
			.لون("#8fa3bf"),

		نص_عنصر(ح.عدد)
			.حجم_خط(96)
			.لون("#ffd479"),

		صف(
			زر("انقص").حجم_خط(26).لون_خلفية("#3a4256").عند_النقر(انقص),
			زر("صفّر").حجم_خط(26).لون_خلفية("#2b3346").عند_النقر(صفر),
			زر("زد").حجم_خط(26).لون_خلفية("#3a4256").عند_النقر(زد)
		).تباعد(16)

	).لون_خلفية("#0b1a2e").حشوة(40).تباعد(24)


تشغيل_تطبيق(الواجهة, عنوان="ألف — عدّاد", عرض=640, ارتفاع=460)
