# ══════════════════════════════════════════════════════════════════════
# الصيغةُ التصريحيّةُ المتسلسلة — نظيرةُ ما تُكتب به الواجهاتُ في لغة ص
#
# لا شيءَ هنا من نحوِ ألف تغيّر: `عمود(...)` استدعاءُ دالّة، و`.لون(...)`
# استدعاءُ طريقةٍ على كائن. الطريقةُ تُعيد العنصرَ نفسَه، فتتّصل السلسلة.
# ══════════════════════════════════════════════════════════════════════

من رسومات استورد نص_عنصر, عمود, صف, تشغيل_تطبيق, رسم_ولقطة

# ─── ألوان ───
لون_السطح = "#0b1a2e"
لون_العنوان = "#ffd479"
لون_النص = "#e6e6e6"
لون_الخافت = "#8fa3bf"

# ─── الشجرةُ التصريحيّة ───
السطح = عمود(
	نص_عنصر("لغةُ ألف ترسم")
		.حجم_خط(40)
		.لون(لون_العنوان),

	نص_عنصر("التشكيلُ العربيُّ يعملُ، والحروفُ موصولة")
		.حجم_خط(26)
		.لون(لون_النص),

	صف(
		نص_عنصر("عمود")   .حجم_خط(20).لون(لون_الخافت),
		نص_عنصر("·")      .حجم_خط(20).لون(لون_الخافت),
		نص_عنصر("صف")     .حجم_خط(20).لون(لون_الخافت),
		نص_عنصر("·")      .حجم_خط(20).لون(لون_الخافت),
		نص_عنصر("سلسلة")  .حجم_خط(20).لون(لون_الخافت)
	).تباعد(18)

).لون_خلفية(لون_السطح).حشوة(36).تباعد(22)

# ─── لقطةٌ للفحص الآليّ، ثمّ النافذةُ الحيّة ───
اطبع("لقطة:", رسم_ولقطة(السطح, "لقطة_متسلسل.bmp", 720, 400))
تشغيل_تطبيق(السطح, عنوان="ألف — رسومات", عرض=720, ارتفاع=400)
