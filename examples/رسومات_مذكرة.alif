من رسومات استورد نص_عنصر, عمود, صف, مذكرة, رسم_ولقطة

عدد_البناءات = 0

دالة رأس():
	عام عدد_البناءات
	عدد_البناءات += 1
	ارجع نص_عنصر("رأسٌ ثابت").حجم_خط(30).لون("#8fa3bf")

صنف حالة:
	دالة __تهيئة__(نفس):
		نفس.عدد = 0
ح = حالة()

دالة الواجهة():
	ارجع عمود(
		مذكرة(رأس),
		نص_عنصر(ح.عدد).حجم_خط(60).لون("#ffd479")
	).لون_خلفية("#0b1a2e").حشوة(24).تباعد(16)

اطبع("١:", رسم_ولقطة(الواجهة, "مذكرة١.bmp", 400, 240), " بناءاتُ الرأس:", عدد_البناءات)
ح.عدد += 1
اطبع("٢:", رسم_ولقطة(الواجهة, "مذكرة٢.bmp", 400, 240), " بناءاتُ الرأس:", عدد_البناءات)
ح.عدد += 1
اطبع("٣:", رسم_ولقطة(الواجهة, "مذكرة٣.bmp", 400, 240), " بناءاتُ الرأس:", عدد_البناءات)
