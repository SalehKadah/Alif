# ══════════════════════════════════════════════════════════════════════
# لوحةٌ بألسنة — جدولٌ وتقويمٌ يتبادلان المكان
#
# ثلاثةُ عناصرَ كانت مستبعَدةً لأنّ المُصيِّرَ يرسم لها شكلاً بلا بيانات:
# `جدول_بيانات` يتجاهل أبناءَه، و`تقويم` صندوقٌ ورمز، و`ألسنة` شريطٌ لا
# يختار. صارت تُبنى تركيباً من عُقَدٍ تعمل، فهذه لوحةٌ حقيقيّة.
#
# المعالِجُ هنا يأخذ وسيطاً: `ألسنة` تُسجّل معالِجاً واحداً لكلّ الألسنة
# وتمرّر إليه رقمَ المنقور، وكذلك `تقويم` تمرّر رقمَ اليوم. فلا يلزمك
# أن تكتب دالّةً لكلّ لسانٍ ولكلّ يوم.
# ══════════════════════════════════════════════════════════════════════

من رسومات استورد نص_عنصر, عمود, جدول_بيانات, تقويم, ألسنة, تشغيل_تطبيق

صنف حالة:
	دالة __تهيئة__(نفس):
		نفس.لسان = 0
		نفس.يوم = 6

ح = حالة()

دالة اختر_لسان(فهرس):
	ح.لسان = فهرس

دالة اختر_يوم(رقم):
	ح.يوم = رقم


اللغات = [
	["ص", 2024, "عربيّة"],
	["ألف", 2022, "عربيّة"],
	["بايثون", 1991, "إنجليزيّة"],
	["سي", 1972, "إنجليزيّة"]
]

دالة الواجهة():
	الشريط = ألسنة(["اللغات", "التقويم"], ح.لسان, عند_اختيار=اختر_لسان, عرض_لسان=140)

	اذا ح.لسان == 0:
		المحتوى = جدول_بيانات(
			["اللغة", "السنة", "الكلمات"],
			اللغات,
			عرض_عمود=150
		)
		الشرح = نص_عنصر("أربعُ لغاتٍ في جدولٍ حقيقيّ — رؤوسٌ وصفوفٌ متناوبة")
	والا:
		المحتوى = تقويم(2026, 9, يوم=ح.يوم, عند_اختيار=اختر_يوم, عرض_خلية=46)
		الشرح = نص_عنصر(م"اليومُ المحدَّد: {ح.يوم} — انقر يوماً آخر")

	ارجع عمود(
		نص_عنصر("لوحةُ ألف").حجم_خط(30).لون("#ffd479"),
		الشريط,
		المحتوى,
		الشرح.حجم_خط(17).لون("#8fa3bf")
	).لون_خلفية("#0b1a2e").حشوة(28).تباعد(18)


تشغيل_تطبيق(الواجهة, عنوان="ألف — لوحة", عرض=680, ارتفاع=620)
